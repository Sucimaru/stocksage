# Demo config — copy to .env if you need to override defaults.
# NO SECRETS HERE. LLM keys are NEVER in this file: Gemini/OpenRouter are
# reached through the connected helpers (Secure Vault surrogate mechanism).
# Wallets are throwaway testnet-only keys generated by src/wallets.js into demo/.

# Base Sepolia RPC (public, no key)
RPC_URL=https://sepolia.base.org
# HTTP port for the research server
PORT=8787
# Optional: override the seller (payTo) address. Default: generated throwaway seller wallet.
# SELLER_ADDRESS=0x...
